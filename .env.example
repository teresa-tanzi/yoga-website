# Copia in .env.local (in locale) e imposta le stesse variabili su Vercel.

# Database Neon (integrazione Vercel Marketplace)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob, per le foto caricate dal backoffice
BLOB_READ_WRITE_TOKEN=

# Backoffice: utente, hash della password (pnpm admin:password) e chiave per firmare la sessione (min 32 caratteri)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
